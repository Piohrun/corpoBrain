{
  "name": "corpobrain",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first second brain with Jira team planning",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run build -w @corpobrain/ui && node scripts/build.mjs",
    "dev": "node --watch --experimental-transform-types packages/server/src/index.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "build:work": "node scripts/build.mjs && node scripts/build-ui.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "esbuild": "^0.25.9"
  }
}
